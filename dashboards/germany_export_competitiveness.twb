      <aliases enabled='yes' />
      <column caption='Germany Forecast Value 2029' datatype='real' name='[Calculation_0699352111169536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [country] = &quot;Germany&quot; THEN [forecast_export_value_usd] END' />
      </column>
      <column caption='China Forecast Value 2029' datatype='real' name='[Calculation_0699352111407105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [country] = &quot;China&quot; THEN [forecast_export_value_usd] END' />
      </column>
      <column caption='Competitive Gap' datatype='real' name='[Calculation_0699352111599618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0699352111407105])&#13;&#10;-&#13;&#10;SUM([Calculation_0699352111169536])' />
      </column>
      <column caption='Competitive Gap 2029 Fixed' datatype='real' name='[Calculation_0699352114307075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF [country] = &quot;China&quot;&#13;&#10;        THEN [forecast_export_value_usd]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}&#13;&#10;-&#13;&#10;{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF [country] = &quot;Germany&quot;&#13;&#10;        THEN [forecast_export_value_usd]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='China Germany Gap 2029 Correct' datatype='real' name='[Calculation_0699352115306500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [country] = &quot;China&quot;&#13;&#10;       AND [year] = 2029&#13;&#10;    THEN [forecast_export_value_usd]&#13;&#10;    END&#13;&#10;)&#13;&#10;-&#13;&#10;SUM(&#13;&#10;    IF [country] = &quot;Germany&quot;&#13;&#10;       AND [year] = 2029&#13;&#10;    THEN [forecast_export_value_usd]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Sector Rank 2025' datatype='real' name='[Calculation_0699352249401349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [product_group] :&#13;&#10;    AVG(&#13;&#10;        IF [year] = 2025&#13;&#10;        THEN [projected_competitor_rank]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Sector Rank 2029' datatype='real' name='[Calculation_0699352249704454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [product_group] :&#13;&#10;    AVG(&#13;&#10;        IF [year] = 2029&#13;&#10;        THEN [projected_competitor_rank]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Sector Rank Change ' datatype='real' name='[Calculation_0699352249847815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0699352249401349] - [Calculation_0699352249704454]' />
      </column>
      <column caption='Competitve Position Change' datatype='string' name='[Calculation_0699352250007560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0699352249847815] &gt; 0 THEN&#13;&#10;      &quot;improving&quot;&#13;&#10;ELSEIF [Calculation_0699352249847815] &lt; 0 THEN&#13;&#10;      &quot;weaking&quot;&#13;&#10;ELSE&#13;&#10;      &quot;stable&quot;&#13;&#10;END' />
      </column>
      <column caption='Sector Competitive Position Status ' datatype='string' name='[Calculation_0699352256610313]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF&#13;&#10;    AVG(&#13;&#10;        IF [year (germany_competitive_position_2025_2029)] = 2029&#13;&#10;        THEN [projected_competitor_rank (germany_competitive_position_2025_2029)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    &lt;&#13;&#10;    AVG(&#13;&#10;        IF [year (germany_competitive_position_2025_2029)] = 2025&#13;&#10;        THEN [projected_competitor_rank (germany_competitive_position_2025_2029)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    &quot;Improving&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    AVG(&#13;&#10;        IF [year (germany_competitive_position_2025_2029)] = 2029&#13;&#10;        THEN [projected_competitor_rank (germany_competitive_position_2025_2029)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    &gt;&#13;&#10;    AVG(&#13;&#10;        IF [year (germany_competitive_position_2025_2029)] = 2025&#13;&#10;        THEN [projected_competitor_rank (germany_competitive_position_2025_2029)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    &quot;Weakening&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Stable&quot;&#13;&#10;END' />
      </column>
      <column caption='Filter - Export Forecast Sector' datatype='boolean' name='[Calculation_0699352472162315]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[product_group (germany_export_forecasts_2025_2029)]&#13;&#10;=&#13;&#10;[Parameters].[Parameter 0699352471113738]' />
