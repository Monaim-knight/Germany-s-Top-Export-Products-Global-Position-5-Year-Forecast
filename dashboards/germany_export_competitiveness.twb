    <worksheet name='KPI3- Competitive Pisition Change'>
      <table>
        <view>
          <datasources>
            <datasource caption='sector_lookup+ (germany_export_analytics)' name='federated.0p7qkda1ngk8nq15iwtu00x6lncs' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Product Group' datatype='string' name='[Parameter 0699352471113738]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vehicles and parts&quot;'>
              <calculation class='tableau' formula='&quot;Vehicles and parts&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p7qkda1ngk8nq15iwtu00x6lncs'>
            <column caption='Sector Competitive Position Status ' datatype='string' name='[Calculation_0699352256610313]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF&#13;&#10;    AVG(&#13;&#10;        IF [year (germany_competitive_position_2025_2029)] = 2029&#13;&#10;        THEN [projected_competitor_rank (germany_competitive_position_2025_2029)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    &lt;&#13;&#10;    AVG(&#13;&#10;        IF [year (germany_competitive_position_2025_2029)] = 2025&#13;&#10;        THEN [projected_competitor_rank (germany_competitive_position_2025_2029)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    &quot;Improving&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    AVG(&#13;&#10;        IF [year (germany_competitive_position_2025_2029)] = 2029&#13;&#10;        THEN [projected_competitor_rank (germany_competitive_position_2025_2029)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    &gt;&#13;&#10;    AVG(&#13;&#10;        IF [year (germany_competitive_position_2025_2029)] = 2025&#13;&#10;        THEN [projected_competitor_rank (germany_competitive_position_2025_2029)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;THEN&#13;&#10;    &quot;Weakening&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Stable&quot;&#13;&#10;END' />
            </column>
            <column caption='Filter - Germany Position Sector' datatype='boolean' name='[Calculation_0699352475811854]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[product_group (germany_competitive_position_2025_2029)]&#13;&#10;=&#13;&#10;[Parameters].[Parameter 0699352471113738]' />
            </column>
            <column-instance column='[Calculation_0699352475811854]' derivation='None' name='[none:Calculation_0699352475811854:nk]' pivot='key' type='nominal' />
            <column caption='Product Group (Germany Competitive Position 2025 2029)' datatype='string' name='[product_group (germany_competitive_position_2025_2029)]' role='dimension' type='nominal' />
            <column caption='Projected Competitor Rank (Germany Competitive Position 2025 2029)' datatype='real' name='[projected_competitor_rank (germany_competitive_position_2025_2029)]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0699352256610313]' derivation='User' name='[usr:Calculation_0699352256610313:nk]' pivot='key' type='nominal' />
            <column caption='Year (Germany Competitive Position 2025 2029)' datatype='integer' name='[year (germany_competitive_position_2025_2029)]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0p7qkda1ngk8nq15iwtu00x6lncs].[none:Calculation_0699352475811854:nk]'>
            <groupfilter function='member' level='[none:Calculation_0699352475811854:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
